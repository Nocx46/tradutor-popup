<?xml version="1.0" encoding="utf-8"?>
<!-- Quadro: sem cor de fundo, só um contorno fino neutro no mesmo tom da barra
     (cinza por fora, claro por dentro, para aparecer em fundos claros e escuros). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#33000000" />
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="#E6F2F2F7" />
            <corners android:bottomLeftRadius="15dp" android:bottomRightRadius="15dp" />
        </shape>
    </item>
</layer-list>
