<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de cima: mesmo vidro claro das caixas de tradução (quase opaco, para o texto
     da página não aparecer por trás) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#F5ECECF1"
        android:startColor="#F7FAFAFC" />
    <stroke android:width="1dp" android:color="#1F000000" />
    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
</shape>
