<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Tradução em tempo real em qualquer site ou app"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <!-- Cartão: ligar o pop-up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <Switch
                android:id="@+id/switchPopup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/popup_switch"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPopupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dar permissão ao pop-up"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cartão: desligar/ligar rápido (apps de banco) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏦  Apps de banco"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Bancos como o Nubank bloqueiam enquanto o tradutor está ligado. Antes de abrir o banco, desligue:\n• toque e segure o botão 文A, ou\n• desligue a chave aqui em cima.\n\nAtalho para ligar/desligar em qualquer lugar: segure os dois botões de volume por 3 segundos. Para ativar o atalho, toque abaixo › Aplicativos instalados › Tradutor Pop-up › ligue &quot;Atalho do Tradutor Pop-up&quot;."
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnShortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Configurar atalho de volume" />
        </LinearLayout>

        <!-- Cartão: idiomas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_source"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/title_target"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTarget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/txtModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cartão: correções de tradução -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️  Correções de tradução"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Se uma tradução sair estranha, escreva a correção aqui, uma por linha, no formato:\nerrado = certo"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editCorrections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:hint="arcos e setas = arco e flecha"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSaveCorrections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salvar correções" />

            <TextView
                android:id="@+id/txtCorrectionsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Já vem com algumas prontas (ex.: arcos e setas → arco e flecha)."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cartão: como usar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_to_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_to"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
